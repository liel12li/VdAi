# Claude API — נדרש כדי ש-Claude יכתוב קופי מותאם לעסק.
# בלי מפתח התוכנה עדיין עובדת עם תבניות מובנות.
ANTHROPIC_API_KEY=sk-ant-...

# אופציונלי
# VDAI_MODEL=claude-opus-4-8
# VDAI_WHISPER_MODEL=small        # tiny / base / small / medium / large-v3
# VDAI_FONT=/path/to/HebrewFont.ttf
# VDAI_OUTPUT_DIR=outputs
# VDAI_MUSIC_DIR=assets/music
